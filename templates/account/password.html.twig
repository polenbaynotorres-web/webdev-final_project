{% extends layout %}
{% block title %}Change Password{% endblock %}
{% block page_heading %}Change Password{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="row">
        <div class="col-lg-6">
            <a href="{{ path('account_profile') }}" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to profile</a>
            <h2 class="h4 mb-1">Change password</h2>
            <p class="text-muted">Use at least 8 characters.</p>

            {% include '_partials/errors.html.twig' %}

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="post" action="{{ path('account_password') }}" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('account_password') }}">
                        <div class="mb-3">
                            <label for="current_password" class="form-label">Current password</label>
                            <input type="password" id="current_password" name="current_password" class="form-control" autocomplete="current-password" required>
                        </div>
                        <div class="mb-3">
                            <label for="new_password" class="form-label">New password</label>
                            <input type="password" id="new_password" name="new_password" class="form-control" minlength="8" autocomplete="new-password" required>
                        </div>
                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">Confirm new password</label>
                            <input type="password" id="confirm_password" name="confirm_password" class="form-control" minlength="8" autocomplete="new-password" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Update password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
