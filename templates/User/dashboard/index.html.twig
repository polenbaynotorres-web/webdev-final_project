
{% extends 'customer/portal.html.twig' %}

{% block title %}Customer Dashboard{% endblock %}

{% block page_heading %}Dashboard{% endblock %}

{% block page_description %}
    Welcome back, {{ app.user.name }}. Here is your rental overview.
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .dashboard-page {
            color: #183653;
        }

        .dashboard-welcome {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            margin-bottom: 28px;
        }

        .dashboard-welcome h1 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .dashboard-welcome p {
            color: #718096;
            margin: 0;
        }

        .dashboard-browse-btn {
            background: #193956;
            color: white;
            border: none;
            border-radius: 9px;
            padding: 12px 20px;
            font-weight: 700;
            text-decoration: none;
            transition: .2s;
        }

        .dashboard-browse-btn:hover {
            background: #2878ca;
            color: white;
            transform: translateY(-2px);
        }

        .dashboard-stat {
            background: #fff;
            border: 1px solid #e1e8f0;
            border-radius: 13px;
            padding: 21px;
            height: 100%;
            box-shadow: 0 4px 14px rgba(24, 54, 83, .04);
            transition: .2s;
        }

        .dashboard-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(24, 54, 83, .09);
        }

        .stat-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 21px;
            margin-bottom: 17px;
        }

        .stat-label {
            color: #718096;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .stat-number {
            font-size: 29px;
            font-weight: 800;
            line-height: 1.2;
            color: #193956;
        }

        .dashboard-section-title {
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 17px;
            color: #183653;
        }

        .dashboard-action {
            display: block;
            background: white;
            border: 1px solid #e1e8f0;
            border-radius: 13px;
            padding: 22px;
            height: 100%;
            color: #183653;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(24, 54, 83, .04);
            transition: .2s;
        }

        .dashboard-action:hover {
            color: #2878ca;
            border-color: #2878ca;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(24, 54, 83, .08);
        }

        .action-icon {
            font-size: 29px;
            margin-bottom: 13px;
        }

        .action-title {
            display: block;
            font-weight: 800;
            font-size: 16px;
            margin-bottom: 6px;
        }

        .action-description {
            color: #718096;
            font-size: 13px;
        }

        .dashboard-reservations {
            background: white;
            border: 1px solid #e1e8f0;
            border-radius: 13px;
            padding: 23px;
            box-shadow: 0 4px 14px rgba(24, 54, 83, .04);
        }

        .dashboard-reservations .table th {
            color: #718096;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .4px;
            font-weight: 700;
            white-space: nowrap;
        }

        .dashboard-reservations .table td {
            color: #344b63;
            font-size: 14px;
        }

        .dashboard-reservations .table > :not(caption) > * > * {
            padding: 15px 10px;
        }

        @media (max-width: 576px) {
            .dashboard-welcome h1 {
                font-size: 21px;
            }

            .dashboard-stat {
                padding: 16px;
            }

            .stat-number {
                font-size: 25px;
            }

            .dashboard-reservations {
                padding: 15px;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="dashboard-page">

    {# Welcome section #}
    <div class="dashboard-welcome">
        <div>
            <h1>Welcome, {{ app.user.name }}!</h1>
            <p>Manage your reservations and plan your next trip.</p>
        </div>

        <a href="{{ path('fleet_index') }}" class="dashboard-browse-btn">
            🚗 Browse Vehicles
        </a>
    </div>

    {# Reservation statistics #}
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl">
            <div class="dashboard-stat">
                <div class="stat-icon" style="background:#e8f1fc;color:#2878ca;">
                    📋
                </div>
                <div class="stat-label">Total Reservations</div>
                <div class="stat-number">{{ totalReservations }}</div>
            </div>
        </div>

        <div class="col-6 col-xl">
            <div class="dashboard-stat">
                <div class="stat-icon" style="background:#fff5df;color:#d99a16;">
                    ⏳
                </div>
                <div class="stat-label">Pending Approval</div>
                <div class="stat-number">{{ pendingReservations }}</div>
            </div>
        </div>

        <div class="col-6 col-xl">
            <div class="dashboard-stat">
                <div class="stat-icon" style="background:#e8f1fc;color:#2878ca;">
                    🚘
                </div>
                <div class="stat-label">Confirmed Bookings</div>
                <div class="stat-number">{{ activeRentals }}</div>
            </div>
        </div>

        <div class="col-6 col-xl">
            <div class="dashboard-stat">
                <div class="stat-icon" style="background:#fff5df;color:#d99a16;">
                    🔄
                </div>
                <div class="stat-label">Pending Returns</div>
                <div class="stat-number">{{ pendingReturns }}</div>
            </div>
        </div>

        <div class="col-6 col-xl">
            <div class="dashboard-stat">
                <div class="stat-icon" style="background:#e5f7ed;color:#15945a;">
                    ✅
                </div>
                <div class="stat-label">Completed Rentals</div>
                <div class="stat-number">{{ completedRentals }}</div>
            </div>
        </div>

    </div>

    {# Quick actions #}
    <h2 class="dashboard-section-title">Quick Actions</h2>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-4">
            <a href="{{ path('fleet_index') }}" class="dashboard-action">
                <div class="action-icon">🚗</div>
                <span class="action-title">Browse Vehicles</span>
                <span class="action-description">
                    Explore vehicles available for rent.
                </span>
            </a>
        </div>

        <div class="col-sm-6 col-lg-4">
            <a href="{{ path('user_reservation_index') }}" class="dashboard-action">
                <div class="action-icon">📅</div>
                <span class="action-title">My Reservations</span>
                <span class="action-description">
                    Review your bookings and their status.
                </span>
            </a>
        </div>

        <div class="col-sm-6 col-lg-4">
            <a href="{{ path('account_profile') }}" class="dashboard-action">
                <div class="action-icon">👤</div>
                <span class="action-title">My Profile</span>
                <span class="action-description">
                    Update your personal information.
                </span>
            </a>
        </div>

    </div>

    {# Recent reservations #}
    <div class="dashboard-reservations">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="dashboard-section-title mb-0">Recent Reservations</h2>

            <a href="{{ path('user_reservation_index') }}"
               class="text-primary text-decoration-none fw-semibold">
                View All →
            </a>
        </div>

        {% if recentReservations is empty %}

            <div class="text-center py-5">
                <div style="font-size:42px;margin-bottom:12px;">🚘</div>

                <h5 class="fw-bold">No reservations yet</h5>

                <p class="text-secondary">
                    You haven't made any vehicle reservations.
                </p>

                <a href="{{ path('fleet_index') }}" class="dashboard-browse-btn d-inline-block">
                    Browse Vehicles
                </a>
            </div>

        {% else %}

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Vehicle</th>
                            <th>Pickup Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for reservation in recentReservations %}
                            <tr>
                                <td class="fw-semibold">
                                    {{ loop.index }}
                                </td>

                                <td class="fw-semibold">
                                    {{ reservation.vehicle.name }}
                                </td>

                                <td>
                                    {{ reservation.pickupDate|date('M d, Y') }}
                                </td>

                                <td>
                                    {{ reservation.returnDate|date('M d, Y') }}
                                </td>

                                <td>
                                    <span class="badge text-bg-{{ reservation.status == 'completed' ? 'success' : (reservation.status == 'cancelled' ? 'secondary' : (reservation.status == 'pending' ? 'warning' : 'primary')) }}">
                                        {{ reservation.status|capitalize }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

        {% endif %}

    </div>

</div>

{% endblock %}
