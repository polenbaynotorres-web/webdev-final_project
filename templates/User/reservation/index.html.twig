
{% extends 'customer/portal.html.twig' %}

{% block title %}My Reservations{% endblock %}

{% block page_heading %}My Reservations{% endblock %}

{% block page_description %}
    View and manage your vehicle reservations.
{% endblock %}

{% block body %}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Reservation History</h1>
        <p class="text-secondary mb-0">
            Your bookings and their latest status.
        </p>
    </div>

    <a href="{{ path('fleet_index') }}" class="btn btn-primary">
        Make a Reservation
    </a>
</div>

<div class="card">
    <div class="card-body p-3 p-md-4">

        {% if reservations is empty %}

            <div class="text-center py-5">
                <div class="display-4 mb-3">🚗</div>

                <h2 class="h5 fw-bold">No reservations yet</h2>

                <p class="text-secondary">
                    Once you book a vehicle, your reservation will appear here.
                </p>

                <a class="btn btn-primary" href="{{ path('fleet_index') }}">
                    Explore Vehicles
                </a>
            </div>

        {% else %}

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Vehicle</th>
                            <th>Pickup</th>
                            <th>Return</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for reservation in reservations %}

                            <tr>
                                <td class="fw-semibold">
                                    {{ loop.index }}
                                </td>

                                <td>
                                    {{ reservation.vehicle.name }}
                                </td>

                                <td class="text-nowrap">
                                    {{ reservation.pickupDate|date('M d, Y') }}
                                    <div class="small text-secondary">
                                        {{ reservation.pickupTime|date('h:i A') }}
                                    </div>
                                </td>

                                <td class="text-nowrap">
                                    {{ reservation.returnDate|date('M d, Y') }}
                                    <div class="small text-secondary">
                                        {{ reservation.returnTime|date('h:i A') }}
                                    </div>
                                </td>

                                <td>
                                    {{ reservation.paymentMethod ?? 'Not specified' }}
                                </td>

                                <td>
                                    <span class="badge text-bg-{{ reservation.status == 'completed' ? 'success' : (reservation.status == 'confirmed' ? 'primary' : (reservation.status == 'pending' ? 'warning' : 'secondary')) }}">
                                        {{ reservation.status|capitalize }}
                                    </span>
                                </td>

                                <td class="text-nowrap">

                                    {% if reservation.status == 'confirmed' and returnRequests[reservation.id] is not defined %}

                                        <a class="btn btn-sm btn-outline-primary mb-1"
                                           href="{{ path('user_return_request', {id: reservation.id}) }}">
                                            Return Vehicle
                                        </a>

                                        <form method="post"
                                              action="{{ path('user_reservation_cancel', {id: reservation.id}) }}"
                                              onsubmit="return confirm('Are you sure you want to cancel this reservation?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('user_cancel_reservation_' ~ reservation.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </button>
                                        </form>

                                    {% elseif reservation.status == 'pending' %}

                                        <form method="post"
                                              action="{{ path('user_reservation_cancel', {id: reservation.id}) }}"
                                              onsubmit="return confirm('Cancel this pending reservation request?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('user_cancel_reservation_' ~ reservation.id) }}">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancel Request
                                            </button>
                                        </form>

                                    {% elseif returnRequests[reservation.id] is defined %}

                                        {% set returnRequest = returnRequests[reservation.id] %}

                                        <span class="badge text-bg-info">
                                            Return: {{ returnRequest.status|capitalize }}
                                        </span>

                                        <div class="small text-secondary mt-1">
                                            {{ returnRequest.customerCondition == 'damage' ? 'Damage reported' : 'No damage reported' }}
                                        </div>

                                    {% else %}

                                        <span class="text-secondary small">
                                            No action available
                                        </span>

                                    {% endif %}

                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>
            </div>

        {% endif %}

    </div>
</div>

{% endblock %}
