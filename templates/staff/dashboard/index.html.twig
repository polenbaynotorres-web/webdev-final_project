{% extends 'staff/base.html.twig' %}{% block title %}Staff Dashboard{% endblock %}{% block page_heading %}Staff Dashboard{% endblock %}{% block body %}<div class="container-fluid"><div class="mb-4"><h3 class="h4 fw-bold">Welcome, {{ app.user.name }}!</h3><p class="text-secondary">Manage day-to-day rental operations and vehicle returns.</p></div>{% for label,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }}">{{ message }}</div>{% endfor %}{% endfor %}<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">Fleet vehicles</div><div class="display-6 fw-bold">{{ totalVehicles }}</div></div></div></div><div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">Reservations</div><div class="display-6 fw-bold">{{ totalReservations }}</div></div></div></div><div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">Pending reservations</div><div class="display-6 fw-bold text-warning">{{ pendingReservations }}</div></div></div></div><div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">Confirmed bookings</div><div class="display-6 fw-bold text-primary">{{ activeRentals }}</div></div></div></div><div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">Pending returns</div><div class="display-6 fw-bold text-warning">{{ pendingReturns }}</div></div></div></div></div><h5 class="fw-bold mb-3">Staff operations</h5><div class="row g-3 mb-4"><div class="col-md-4"><a href="{{ path('vehicle_index') }}" class="card card-body border-0 shadow-sm text-decoration-none"><strong>🚘 Vehicle list</strong><span class="small text-secondary">View fleet and vehicle information</span></a></div><div class="col-md-4"><a href="{{ path('reservation_index') }}" class="card card-body border-0 shadow-sm text-decoration-none"><strong>📋 Reservations</strong><span class="small text-secondary">Review customer reservations</span></a></div><div class="col-md-4"><a href="{{ path('manage_return_index') }}" class="card card-body border-0 shadow-sm text-decoration-none"><strong>↩ Vehicle returns</strong><span class="small text-secondary">Inspect and confirm returns</span></a></div><div class="col-md-4"><a href="{{ path('staff_profile') }}" class="card card-body border-0 shadow-sm text-decoration-none"><strong>👤 My profile</strong><span class="small text-secondary">Update your own account</span></a></div></div><div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Recent reservations</h5><a href="{{ path('reservation_index') }}">View all</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Vehicle</th><th>Pickup</th><th>Status</th></tr></thead><tbody>{% for r in recentReservations %}<tr><td>{{ r.user.name }}</td><td>{{ r.vehicle.name }}</td><td>{{ r.pickupDate|date('M d, Y') }}</td><td><span class="badge text-bg-{{ r.status == 'completed' ? 'success' : (r.status == 'cancelled' ? 'secondary' : (r.status == 'pending' ? 'warning' : 'primary')) }}">{{ r.status|capitalize }}</span></td></tr>{% else %}<tr><td colspan="4" class="text-center text-secondary py-4">No reservations recorded.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="fw-bold mb-0">Returns requiring attention</h5><a href="{{ path('manage_return_index') }}">Open return desk</a></div>{% for item in pendingReturnItems %}<div class="d-flex flex-wrap justify-content-between border-bottom py-2 gap-2"><div><strong>#{{ item.reservation.id }} · {{ item.reservation.vehicle.name }}</strong><div class="small text-secondary">{{ item.reservation.user.name }} · {{ item.requestedAt|date('M d, Y h:i A') }}</div></div><span class="badge text-bg-{{ item.status == 'pending' ? 'warning' : 'info' }} align-self-center">{{ item.status|capitalize }}</span></div>{% else %}<p class="text-secondary mb-0">There are no pending return inspections.</p>{% endfor %}</div></div></div>{% endblock %}
