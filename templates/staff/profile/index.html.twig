{% extends 'staff/base.html.twig' %}{% block title %}My Profile{% endblock %}{% block page_heading %}My Profile{% endblock %}{% block body %}<div class="container-fluid"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h3 class="h5">Account details</h3><p class="text-secondary">Update your own name, email, and password.</p>{% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}{% for error in errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('account_profile_' ~ account.id) }}"><label class="form-label">Full name</label><input class="form-control mb-3" name="name" value="{{ account.name }}" maxlength="120" required><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" value="{{ account.email }}" required><hr><h5 class="h6">Change password</h5><label class="form-label">Current password</label><input class="form-control mb-3" type="password" name="current_password"><label class="form-label">New password</label><input class="form-control mb-4" type="password" name="new_password" minlength="8"><button class="btn btn-primary">Save changes</button></form></div></div></div>{% endblock %}
