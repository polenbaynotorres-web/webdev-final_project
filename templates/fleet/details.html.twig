{% extends 'base.html.twig' %}{% block title %}{{ vehicle.name }} | Torres Vehicle Rental{% endblock %}{% block stylesheets %}<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f5f7fb}.detail{max-width:1100px;margin:45px auto;padding:20px}.vehicle-photo{width:100%;height:390px;object-fit:contain;background:white;border-radius:16px}.panel{background:#fff;border-radius:16px;padding:28px;box-shadow:0 5px 25px #0f172a0b}</style>{% endblock %}{% block body %}<main class="detail"><a href="{{ path('fleet_index') }}" class="text-decoration-none">← Back to fleet</a><div class="row g-4 mt-2"><div class="col-lg-7">{% set imageFilename = vehicle.imagePath|split('/')|last %}<img class="vehicle-photo" src="{{ vehicle.imagePath starts with 'uploads/' ? asset(vehicle.imagePath) : asset('images/' ~ imageFilename) }}" alt="{{ vehicle.name }}"></div><div class="col-lg-5"><div class="panel"><span class="badge text-bg-success mb-3">Vehicle details</span><h1 class="fw-bold">{{ vehicle.name }}</h1><p class="text-secondary">{{ vehicle.vehicleClass|replace({'car-':'','motorcycle-scooter':'Scooter'})|title }} · {{ vehicle.seats }} seats</p><div class="display-6 fw-bold text-primary">₱{{ vehicle.price|number_format(2,'.',',') }} <small class="fs-6 text-secondary">/ day</small></div><hr><h6>Available colors</h6>{% set available = colors|filter(c => c.inStock) %}{% for color in available %}<span class="badge text-bg-light border text-dark me-1 mb-2">{{ color.colorName }}</span>{% else %}<p class="text-danger">Currently unavailable</p>{% endfor %}<p class="text-secondary small mt-3">Select your preferred color and rental dates on the booking page.</p>{% if available is not empty %}<a class="btn btn-primary btn-lg w-100" href="{{ path('user_vehicle_book',{slug:vehicle.slug}) }}">Reserve this vehicle</a>{% else %}<button class="btn btn-secondary w-100" disabled>Currently unavailable</button>{% endif %}</div></div></div></main>{% endblock %}
