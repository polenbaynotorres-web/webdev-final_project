
{% extends is_granted('ROLE_ADMIN') ? 'admin/base.html.twig' : 'staff/base.html.twig' %}

{% block title %}Manage Reservations{% endblock %}

{% block page_heading %}Reservation Management{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="mb-4">
        <h2 class="h4 mb-1">Reservations</h2>
        <p class="text-muted mb-0">
            View and monitor all vehicle rental reservations.
        </p>
    </div>

    {# SEARCH AND FILTERS #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form method="get" action="{{ path('reservation_index') }}">
                <div class="row g-3 align-items-end">

                    <div class="col-md-6">
                        <label for="search" class="form-label">
                            Search reservations
                        </label>

                        <input
                            type="text"
                            id="search"
                            name="search"
                            class="form-control"
                            placeholder="Customer, vehicle, location, or phone"
                            value="{{ search|default('') }}"
                        >
                    </div>

                    <div class="col-md-3">
                        <label for="status" class="form-label">
                            Filter by status
                        </label>

                        <select id="status" name="status" class="form-select">
                            <option value="">All statuses</option>

                            <option value="pending" {{ status == 'pending' ? 'selected' : '' }}>
                                Pending
                            </option>

                            <option value="confirmed" {{ status == 'confirmed' ? 'selected' : '' }}>
                                Confirmed
                            </option>

                            <option value="cancelled" {{ status == 'cancelled' ? 'selected' : '' }}>
                                Cancelled
                            </option>

                            <option value="completed" {{ status == 'completed' ? 'selected' : '' }}>
                                Completed
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>

                        <a
                            href="{{ path('reservation_index') }}"
                            class="btn btn-outline-secondary"
                        >
                            Reset
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    {# RESERVATIONS TABLE #}
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            {% if reservations is not empty %}

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>No.</th>
                                <th>Customer</th>
                                <th>Vehicle</th>
                                <th>Pickup Location</th>
                                <th>Pickup Date</th>
                                <th>Return Date</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for reservation in reservations %}
                                <tr>
                                    <td>
                                        <strong>{{ loop.index }}</strong>
                                    </td>

                                    <td>
                                        <strong>{{ reservation.user.name }}</strong>

                                        <div class="small text-muted">
                                            {{ reservation.user.email ?? 'No email provided' }}
                                        </div>

                                        <div class="small text-muted">
                                            {{ reservation.phone }}
                                        </div>
                                    </td>

                                    <td>
                                        {{ reservation.vehicle.name }}
                                    </td>

                                    <td>
                                        {{ reservation.location.name }}
                                    </td>

                                    <td>
                                        {{ reservation.pickupDate|date('M d, Y') }}

                                        <div class="small text-muted">
                                            {{ reservation.pickupTime|date('h:i A') }}
                                        </div>
                                    </td>

                                    <td>
                                        {{ reservation.returnDate|date('M d, Y') }}

                                        <div class="small text-muted">
                                            {{ reservation.returnTime|date('h:i A') }}
                                        </div>
                                    </td>

                                    <td>
                                        {{ reservation.paymentMethod ?? 'Not specified' }}
                                    </td>

                                    <td>
                                        {% if reservation.status == 'pending' %}
                                            <span class="badge bg-warning text-dark">
                                                Pending Approval
                                            </span>

                                        {% elseif reservation.status == 'confirmed' %}
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>

                                        {% elseif reservation.status == 'completed' %}
                                            <span class="badge bg-info text-dark">
                                                Completed
                                            </span>

                                        {% else %}
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td class="text-nowrap">

                                        <a
                                            class="btn btn-sm btn-outline-primary"
                                            href="{{ path('reservation_show', {id: reservation.id}) }}"
                                        >
                                            View
                                        </a>

                                        {% if reservation.status == 'pending' %}

                                            <form
                                                method="post"
                                                action="{{ path('reservation_confirm', {id: reservation.id}) }}"
                                                class="d-inline"
                                                onsubmit="return confirm('Approve this reservation?');"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('confirm_reservation_' ~ reservation.id) }}"
                                                >

                                                <button
                                                    class="btn btn-sm btn-success"
                                                    type="submit"
                                                >
                                                    Approve
                                                </button>
                                            </form>

                                            <form
                                                method="post"
                                                action="{{ path('reservation_cancel', {id: reservation.id}) }}"
                                                class="d-inline"
                                                onsubmit="return confirm('Reject/cancel this reservation?');"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}"
                                                >

                                                <button
                                                    class="btn btn-sm btn-outline-danger"
                                                    type="submit"
                                                >
                                                    Reject
                                                </button>
                                            </form>

                                        {% endif %}

                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>

                    </table>
                </div>

                <div class="mt-3 text-muted small">
                    Showing {{ reservations|length }}
                    {{ reservations|length == 1 ? 'reservation' : 'reservations' }}.
                </div>

            {% else %}

                <div class="text-center py-5">
                    <h5>No reservations found</h5>

                    <p class="text-muted mb-0">
                        No reservations match your search or selected filter.
                    </p>
                </div>

            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
