{% extends is_granted('ROLE_ADMIN') ? 'admin/base.html.twig' : 'staff/base.html.twig' %}

{% block title %}Manage Vehicles{% endblock %}

{% block page_heading %}Vehicle Management{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h4 mb-1">Vehicles</h2>
            <p class="text-muted mb-0">Manage all vehicles in the rental system.</p>
        </div>

        <a href="{{ path('vehicle_new') }}" class="btn btn-primary">
            Add Vehicle
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            {% if vehicles is not empty %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Vehicle</th>
                                <th>Category</th>
                                <th>Seats</th>
                                <th>Price per Day</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for vehicle in vehicles %}
                                {% set imageUrl = vehicle.imagePath starts with 'assets/img/'
                                    ? 'images/' ~ vehicle.imagePath|replace({'assets/img/': ''})
                                    : vehicle.imagePath %}

                                <tr>
                                    <td>
                                        <img
                                            src="{{ asset(imageUrl) }}"
                                            alt="{{ vehicle.name }}"
                                            style="width: 100px; height: 65px; object-fit: contain;"
                                        >
                                    </td>

                                    <td>
                                        <strong>{{ vehicle.name }}</strong>
                                        <div class="small text-muted">
                                            {{ vehicle.slug }}
                                        </div>
                                    </td>

                                    <td>
                                        {{ vehicle.vehicleClass|replace({'-': ' '})|title }}
                                    </td>

                                    <td>{{ vehicle.seats }}</td>

                                    <td>
                                        ₱{{ vehicle.price|number_format(2, '.', ',') }}
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">

                                            <a
                                                href="{{ path('vehicle_edit', {id: vehicle.id}) }}"
                                                class="btn btn-sm btn-outline-primary"
                                            >
                                                Edit
                                            </a>

                                            <form
                                                method="post"
                                                action="{{ path('vehicle_delete', {id: vehicle.id}) }}"
                                                onsubmit="return confirm('Are you sure you want to delete this vehicle?');"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('delete_vehicle_' ~ vehicle.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                >
                                                    Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {% else %}
                <div class="text-center py-5">
                    <h5>No vehicles found</h5>
                    <p class="text-muted">
                        Add your first vehicle to get started.
                    </p>
                    <a href="{{ path('vehicle_new') }}" class="btn btn-primary">
                        Add Vehicle
                    </a>
                </div>
            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
