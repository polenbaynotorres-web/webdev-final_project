
{% extends is_granted('ROLE_ADMIN') ? 'admin/base.html.twig' : 'staff/base.html.twig' %}

{% block title %}Vehicle Colors{% endblock %}
{% block page_heading %}Vehicle Colors{% endblock %}

{% block body %}
<div class="container-fluid px-0">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a href="{{ path('vehicle_index') }}"
               class="btn btn-sm btn-outline-secondary mb-2">
                &larr; Back to vehicles
            </a>

            <h3 class="mb-1">{{ vehicle.name }} — Colors</h3>

            <p class="text-muted mb-0">
                Manage color options, photos, and stock availability for this vehicle.
            </p>
        </div>

        <a href="{{ path('vehicle_color_new', {vehicleId: vehicle.id}) }}"
           class="btn btn-primary">
            Add Color
        </a>
    </div>

    {% include '_partials/flashes.html.twig' %}

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Image</th>
                            <th>Color</th>
                            <th>Availability</th>
                            <th>Last Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                    {% for color in colors %}
                        <tr>

                            <td>
                                <strong>{{ loop.index }}</strong>
                            </td>

                            <td>
                                <img
                                    src="{{ asset(color.imagePath) }}"
                                    alt="{{ color.colorName }}"
                                    style="width:110px;height:70px;object-fit:contain">
                            </td>

                            <td class="fw-semibold">
                                {{ color.colorName }}
                            </td>

                            <td>
                                {% if color.inStock %}
                                    <span class="badge bg-success">Available</span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        Unavailable / Reserved
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                {{ color.updatedAt ? color.updatedAt|date('M d, Y h:i A') : '—' }}
                            </td>

                            <td class="text-end text-nowrap">

                                <a
                                    href="{{ path('vehicle_color_edit', {
                                        vehicleId: vehicle.id,
                                        colorId: color.id
                                    }) }}"
                                    class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form
                                    method="post"
                                    action="{{ path('vehicle_color_delete', {
                                        vehicleId: vehicle.id,
                                        colorId: color.id
                                    }) }}"
                                    class="d-inline"
                                    onsubmit="return confirm('Delete this color? Colors used by reservation history cannot be deleted.');">

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('vehicle_color_delete_' ~ color.id) }}">

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>

                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No color options have been added for this vehicle yet.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}
