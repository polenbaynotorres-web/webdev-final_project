
{% extends 'admin/base.html.twig' %}

{% block title %}Admin Dashboard | Torres Vehicle Rental{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    {% for item in [
        {label: 'Total Vehicles', description: 'Vehicle records will appear here'},
        {label: 'Reservations', description: 'Reservation records will appear here'},
        {label: 'Customers', description: 'Customer records will appear here'},
        {label: 'Messages', description: 'Contact messages will appear here'}
    ] %}
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="text-secondary">{{ item.label }}</div>
                <h2 class="fw-bold mt-2">—</h2>
                <small>{{ item.description }}</small>
            </div>
        </div>
    {% endfor %}
</div>

<div class="card border-0 shadow-sm p-4">
    <h5 class="fw-bold">Welcome to Torres Vehicle Rental</h5>
    <p class="text-secondary mb-0">
        Manage your vehicles, reservations, customers, and messages
        from one place.
    </p>
</div>
{% endblock %}
