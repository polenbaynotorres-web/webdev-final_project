{% extends 'admin/base.html.twig' %}

{% block title %}Edit Staff Account{% endblock %}
{% block page_heading %}Edit Staff Account{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <h3 class="mb-1">Edit Staff Account</h3>
    <p class="text-muted mb-4">Update the staff member's information.</p>

    {% include 'admin/staff/_form.html.twig' with {
        formAction: path('admin_staff_edit', {id: staff.id}),
        csrfTokenId: 'staff_edit_' ~ staff.id,
        isEdit: true
    } %}
</div>
{% endblock %}