
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Admin Dashboard{% endblock %} | Torres Vehicle Rental</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/admin.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body class="admin-body">

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-brand">
            <img src="{{ asset('images/logo-cropped.png') }}" alt="Torres Logo">
        </div>

        <div class="sidebar-label">ADMIN MENU</div>

        <nav class="sidebar-nav">

            <a href="{{ path('admin_dashboard') }}"
               class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                <span class="sidebar-icon">&#9638;</span>
                <span>Dashboard</span>
            </a>

            <div class="sidebar-label">MANAGEMENT</div>

            <a href="{{ path('vehicle_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'vehicle_' or app.request.attributes.get('_route') starts with 'vehicle_color_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#128663;</span>
                <span>Manage Vehicles</span>
            </a>

            <a href="{{ path('reservation_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'reservation_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#9636;</span>
                <span>Reservations</span>
            </a>

            <a href="{{ path('admin_customer_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'admin_customer_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#9817;</span>
                <span>Customers</span>
            </a>

            <a href="{{ path('admin_staff_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'admin_staff_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#128101;</span>
                <span>Staff Accounts</span>
            </a>

            <a href="{{ path('admin_message_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'admin_message_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#9993;</span>
                <span>Messages</span>
            </a>

            <a href="{{ path('admin_location_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'admin_location_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#128205;</span>
                <span>Locations</span>
            </a>

            <a href="{{ path('manage_return_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'manage_return_' ? 'active' : '' }}">
                <span class="sidebar-icon">&#8635;</span>
                <span>Vehicle Returns</span>
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a href="/">
                <span class="sidebar-icon">&#x2302;</span>
                <span>View Homepage</span>
            </a>

            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">

                <button type="submit" class="sidebar-logout">
                    <span class="sidebar-icon">&#x21E5;</span>
                    <span>Logout</span>
                </button>
            </form>

        </div>

    </aside>

    <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>

    <main class="admin-main">

        <header class="admin-topbar">

            <div class="admin-header-left">

                <button type="button"
                        class="admin-sidebar-toggle"
                        id="adminSidebarToggle"
                        aria-label="Collapse sidebar"
                        aria-controls="adminSidebar"
                        aria-expanded="true">
                    &#x2630;
                </button>

                <div class="admin-heading">
                    <span class="admin-header-label">TORRES VEHICLE RENTAL</span>
                    <h2>{% block page_heading %}Admin Dashboard{% endblock %}</h2>
                    <p>Admin Workspace</p>
                </div>

            </div>

            <div class="admin-profile">

                <div class="admin-avatar">
                    {{ app.user.name|first|upper }}
                </div>

                <div class="admin-profile-info">
                    <strong>{{ app.user.name }}</strong>
                    <span>Administrator</span>
                </div>

            </div>

        </header>

        <section class="admin-content">
            {% block body %}{% endblock %}
        </section>

        <footer class="admin-footer">
            <p>
                &copy; {{ "now"|date("Y") }}
                Torres Vehicle Rental.
                All rights reserved.
            </p>

            <span>Admin Workspace</span>
        </footer>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const toggle = document.getElementById('adminSidebarToggle');
            const backdrop = document.getElementById('adminSidebarBackdrop');
            const mobileScreen = window.matchMedia('(max-width: 760px)');

            if (!toggle || !backdrop) {
                return;
            }

            function updateButton() {
                const isOpen = mobileScreen.matches
                    ? body.classList.contains('sidebar-open')
                    : !body.classList.contains('sidebar-collapsed');

                toggle.setAttribute('aria-expanded', String(isOpen));
                toggle.setAttribute(
                    'aria-label',
                    isOpen ? 'Collapse sidebar' : 'Expand sidebar'
                );
            }

            toggle.addEventListener('click', function () {
                if (mobileScreen.matches) {
                    body.classList.toggle('sidebar-open');
                } else {
                    body.classList.toggle('sidebar-collapsed');
                }

                updateButton();
            });

            backdrop.addEventListener('click', function () {
                body.classList.remove('sidebar-open');
                updateButton();
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    body.classList.remove('sidebar-open');
                    updateButton();
                }
            });

            mobileScreen.addEventListener('change', function () {
                body.classList.remove('sidebar-open');
                body.classList.remove('sidebar-collapsed');
                updateButton();
            });

            updateButton();
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}

</body>
</html>
