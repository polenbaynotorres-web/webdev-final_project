
{% extends 'admin/base.html.twig' %}

{% block title %}Locations{% endblock %}
{% block page_heading %}Locations{% endblock %}

{% block body %}

<style>
    .location-page {
        width: 100%;
    }

    .location-header {
        margin-bottom: 28px;
    }

    .location-header h3 {
        font-size: 26px;
        font-weight: 700;
        color: #172f49;
        margin-bottom: 8px;
    }

    .location-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .location-layout {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.65fr);
        gap: 24px;
        width: 100%;
        align-items: start;
    }

    .location-card {
        background: #fff;
        border: 1px solid #e9edf2;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        min-width: 0;
    }

    .location-card-body {
        padding: 24px;
    }

    .location-card-title {
        font-size: 19px;
        font-weight: 700;
        color: #172f49;
        margin-bottom: 20px;
    }

    .location-form label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 8px;
    }

    .location-form .form-control {
        min-height: 44px;
        border-radius: 7px;
    }

    .location-form .btn {
        min-height: 42px;
        padding: 9px 20px;
        font-weight: 600;
        border-radius: 7px;
    }

    .location-table {
        width: 100%;
        margin-bottom: 0;
        table-layout: auto;
    }

    .location-table th {
        background: #f5f7fa;
        color: #34495e;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 15px 14px;
        white-space: nowrap;
    }

    .location-table td {
        padding: 16px 14px;
        vertical-align: middle;
        color: #34495e;
    }

    .location-table tbody tr:hover {
        background: #f8fafc;
    }

    .location-id {
        width: 65px;
        color: #7b8794 !important;
    }

    .location-name {
        font-weight: 600;
        color: #172f49 !important;
    }

    .location-slug {
        color: #718096 !important;
    }

    .location-actions {
        text-align: right;
        white-space: nowrap;
        min-width: 150px;
    }

    .location-actions .btn {
        margin-left: 4px;
        border-radius: 6px;
        font-weight: 500;
    }

    .location-count {
        font-size: 13px;
        color: #7b8794;
        margin-left: 6px;
    }

    @media (max-width: 900px) {
        .location-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 576px) {
        .location-card-body {
            padding: 16px;
        }

        .location-header h3 {
            font-size: 22px;
        }
    }
</style>

<div class="location-page">

    <div class="location-header">
        <h3>Pickup Locations</h3>
        <p>
            Manage the pickup locations customers can choose when making a reservation.
        </p>
    </div>

    {% include '_partials/flashes.html.twig' %}
    {% include '_partials/errors.html.twig' %}

    <div class="location-layout">

        {# ADD LOCATION FORM #}
        <div class="location-card">
            <div class="location-card-body">

                <h5 class="location-card-title">
                    <i class="bi bi-geo-alt me-2"></i>
                    Add New Location
                </h5>

                <form
                    method="post"
                    action="{{ path('admin_location_index') }}"
                    class="location-form"
                    novalidate
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('location_new') }}"
                    >

                    <div class="mb-3">
                        <label for="name" class="form-label">
                            Location Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="form-control"
                            maxlength="120"
                            required
                            placeholder="Enter location name"
                            value="{{ name|default('') }}"
                        >
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Location
                    </button>
                </form>

                <hr class="my-4">

                <div class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Add locations that customers can select during vehicle reservations.
                </div>

            </div>
        </div>

        {# LOCATION TABLE #}
        <div class="location-card">
            <div class="location-card-body">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h5 class="location-card-title mb-0">
                        <i class="bi bi-list-ul me-2"></i>
                        Existing Locations
                    </h5>

                    <span class="location-count">
                        {{ locations|length }} location(s)
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle location-table">

                        <thead>
                            <tr>
                                <th class="location-id">No.</th>
                                <th>Name</th>
                                <th>Slug</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for location in locations %}
                            <tr>
                                <td class="location-id">
                                    {{ loop.index }}
                                </td>

                                <td class="location-name">
                                    {{ location.name }}
                                </td>

                                <td class="location-slug">
                                    {{ location.slug }}
                                </td>

                                <td class="location-actions">

                                    <a
                                        href="{{ path('admin_location_edit', {id: location.id}) }}"
                                        class="btn btn-sm btn-outline-primary"
                                    >
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('admin_location_delete', {id: location.id}) }}"
                                        class="d-inline"
                                        onsubmit="return confirm('Delete this location?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('location_delete_' ~ location.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                        >
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>

                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-geo-alt fs-3 d-block mb-2"></i>
                                    No locations have been added yet.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>

</div>

{% endblock %}
