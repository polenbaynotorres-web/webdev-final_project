{% extends 'admin/base.html.twig' %}
{% block title %}Edit Location{% endblock %}
{% block page_heading %}Edit Location{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="row">
        <div class="col-lg-6">
            <a href="{{ path('admin_location_index') }}" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to locations</a>
            <h3 class="mb-3">Edit location</h3>
            {% include '_partials/errors.html.twig' %}
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form method="post" action="{{ path('admin_location_edit', {id: location.id}) }}" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('location_edit_' ~ location.id) }}">
                        <div class="mb-3">
                            <label for="name" class="form-label">Location name</label>
                            <input type="text" id="name" name="name" class="form-control" maxlength="120" required value="{{ name }}">
                        </div>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a href="{{ path('admin_location_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
