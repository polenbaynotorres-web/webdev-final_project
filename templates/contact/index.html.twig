
{% extends 'customer/portal.html.twig' %}

{% block title %}Contact Us | Torres Vehicle Rental{% endblock %}

{% block portal_eyebrow %}CUSTOMER SUPPORT{% endblock %}

{% block page_heading %}Contact Us{% endblock %}

{% block page_description %}
    Have questions? We're here to help you.
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .contact-page {
            max-width: 1000px;
            margin: 0 auto;
        }

        .contact-intro {
            margin-bottom: 25px;
        }

        .contact-intro h2 {
            color: #193956;
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .contact-intro p {
            color: #718096;
            margin-bottom: 0;
        }

        .contact-card {
            background: #fff;
            border: 1px solid #e1e8f0;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(24, 54, 83, .05);
        }

        .contact-card .form-label {
            color: #193956;
            font-weight: 700;
            font-size: 14px;
        }

        .contact-card .form-control {
            border: 1px solid #dce4ed;
            border-radius: 9px;
            padding: 12px 14px;
            font-size: 14px;
        }

        .contact-card .form-control:focus {
            border-color: #2878ca;
            box-shadow: 0 0 0 3px rgba(40, 120, 202, .12);
        }

        .contact-submit {
            background: #193956;
            color: white;
            border: none;
            border-radius: 9px;
            padding: 12px 25px;
            font-weight: 700;
        }

        .contact-submit:hover {
            background: #2878ca;
            color: white;
        }

        @media (max-width: 576px) {
            .contact-card {
                padding: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="contact-page">

    <div class="contact-intro">
        <h2>We'd Love to Hear From You!</h2>
        <p>
            Questions about a rental? Send us a message and our team
            will get back to you as soon as possible.
        </p>
    </div>

    {% include '_partials/errors.html.twig' %}

    <div class="contact-card">

        <form method="post" action="{{ path('contact') }}" novalidate>

            <input type="hidden"
                   name="_token"
                   value="{{ csrf_token('contact_form') }}">

            <div class="row g-4">

                <div class="col-md-6">
                    <label for="name" class="form-label">Full Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        maxlength="120"
                        required
                        value="{{ form.name }}"
                        placeholder="Enter your full name">
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        maxlength="190"
                        required
                        value="{{ form.email }}"
                        placeholder="Enter your email address">
                </div>

                <div class="col-12">
                    <label for="subject" class="form-label">Subject</label>
                    <input
                        type="text"
                        id="subject"
                        name="subject"
                        class="form-control"
                        maxlength="190"
                        required
                        value="{{ form.subject }}"
                        placeholder="What is your inquiry about?">
                </div>

                <div class="col-12">
                    <label for="message" class="form-label">Your Message</label>
                    <textarea
                        id="message"
                        name="message"
                        class="form-control"
                        rows="6"
                        minlength="10"
                        maxlength="2000"
                        required
                        placeholder="Write your message here...">{{ form.message }}</textarea>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="contact-submit">
                    Send Message →
                </button>
            </div>

        </form>

    </div>

</div>

{% endblock %}
